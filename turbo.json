{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["*"]
		}
	},
	"globalEnv": [
		"CI",
		"GEMINI_API_KEY",
		"GEMINI_KEY_FROM_ENV",
		"NODE_ENV",
		"PORT"
	],
	"globalDependencies": [".env*"]
}
