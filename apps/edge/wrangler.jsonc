{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gemini-hack",
	"account_id": "09a97e9c1632b412730e20bcce67b75e",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "hackathon.sparkyidea.com", "custom_domain": true }],
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"containers": [
		{
			"class_name": "ApiServer",
			"image": "../server/Dockerfile",
			"image_build_context": "../..",
			"instance_type": "standard-1",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "API", "class_name": "ApiServer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiServer"] }],
	"observability": { "enabled": true }
}
