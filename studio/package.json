{
  "name": "studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.mjs\" \"vite --config web/vite.config.ts\"",
    "server": "node server/index.mjs",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
